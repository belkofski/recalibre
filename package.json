{
  "name": "recalibre-site",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.9",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev -p 3111",
    "build": "next build",
    "start": "next start -p ${PORT:-3111}",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "images": "node scripts/image-manifest.mjs",
    "check:images": "node scripts/image-manifest.mjs --check && node scripts/check-images.mjs",
    "check:routes": "node scripts/check-routes.mjs",
    "check:site": "node scripts/check-site.mjs",
    "verify": "npm run typecheck && npm run lint && npm run check:images && npm run check:routes && npm run build && npm run check:site"
  },
  "dependencies": {
    "@next/third-parties": "^16.4.5",
    "motion": "^14.9.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
