{
  "name": "clone-elyte",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3111",
    "prebuild": "node scripts/check-form-env.mjs",
    "build": "next build",
    "start": "next start -p ${PORT:-3111}",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "images": "node scripts/image-manifest.mjs",
    "check:images": "node scripts/image-manifest.mjs --check && node scripts/check-images.mjs"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
